{
  "key": "langease-morph",
  "name": "LangEase morph",
  "style": "flow",
  "aliases": [
    "langease",
    "continuous morph",
    "button to sparkle",
    "button morph",
    "morph into logo",
    "one take"
  ],
  "tags": [
    "morph",
    "cursor",
    "sparkle",
    "motion path",
    "trail",
    "confetti",
    "logo"
  ],
  "summary": "A click on a button makes it swell into a blob, turn into a sparkle that flies on a trail and lands as the logo mark beside the wordmark. One continuous take, no cuts.",
  "how": [
    "A hand cursor clicks the button (cursor clicks), and the click causes everything after it.",
    "The button is a pill shape with width, height and radius keyframes: it swells into a circle.",
    "morphTo \"sparkle\" with morph keyframed 0 to 1 turns the circle into the sparkle.",
    "motionPath with a trail flies the sparkle to its place beside the wordmark; the wordmark arrives with focusIn as it lands.",
    "A small confetti burst on the click sells the moment. Keep the label as its own text layer and fade it before the swell."
  ],
  "spec": {
    "title": "LangEase morph",
    "theme": {
      "colors": {
        "bg": "#F6F6FB",
        "text": "#14141F",
        "muted": "#8B8BA0",
        "border": "#E3E4EE",
        "surface": "#FFFFFF",
        "primary": "#4F46E5",
        "secondary": "#38BDF8"
      },
      "fonts": {
        "display": "Inter",
        "body": "Inter"
      }
    },
    "post": {
      "bloom": false,
      "grain": 0,
      "vignette": 0
    },
    "sfx": {
      "kit": "soft"
    },
    "scenes": [
      {
        "id": "morph",
        "duration": 6.5,
        "background": "$bg",
        "camera": {
          "moves": [
            {
              "preset": "pushIn",
              "amount": 80,
              "duration": 6.5,
              "ease": "inOutSine"
            }
          ]
        },
        "layers": [
          {
            "type": "text",
            "text": "Ready when you are.",
            "size": 68,
            "weight": 500,
            "letterSpacing": -0.025,
            "y": 170,
            "animate": {
              "preset": "build"
            },
            "animateOut": {
              "preset": "auto"
            },
            "end": 2.3
          },
          {
            "type": "shape",
            "shape": "pill",
            "id": "cta",
            "width": 280,
            "height": 84,
            "radius": 42,
            "fill": {
              "type": "linear",
              "from": "$primary",
              "to": "$secondary",
              "angle": 135
            },
            "y": -30,
            "shadow": {
              "blur": 40,
              "y": -16,
              "opacity": 0.18,
              "color": "$primary"
            },
            "morphTo": "sparkle",
            "in": {
              "preset": "scaleIn",
              "from": 0.8,
              "at": 0.5
            },
            "keyframes": {
              "scale": [
                {
                  "t": 1.6,
                  "v": 1
                },
                {
                  "t": 1.72,
                  "v": 0.93,
                  "ease": "outQuad"
                },
                {
                  "t": 1.95,
                  "v": 1,
                  "ease": "outBack"
                }
              ],
              "width": [
                {
                  "t": 1.95,
                  "v": 280
                },
                {
                  "t": 2.55,
                  "v": 130,
                  "ease": "inOutCubic"
                }
              ],
              "height": [
                {
                  "t": 1.95,
                  "v": 84
                },
                {
                  "t": 2.55,
                  "v": 130,
                  "ease": "inOutCubic"
                }
              ],
              "radius": [
                {
                  "t": 1.95,
                  "v": 42
                },
                {
                  "t": 2.55,
                  "v": 65,
                  "ease": "inOutCubic"
                }
              ],
              "morph": [
                {
                  "t": 2.6,
                  "v": 0
                },
                {
                  "t": 3.05,
                  "v": 1,
                  "ease": "inOutCubic"
                }
              ],
              "rotate": [
                {
                  "t": 2.6,
                  "v": 0
                },
                {
                  "t": 4.3,
                  "v": 180,
                  "ease": "inOutCubic"
                }
              ]
            },
            "motionPath": {
              "points": [
                [
                  0,
                  -30
                ],
                [
                  230,
                  120
                ],
                [
                  -40,
                  210
                ],
                [
                  -230,
                  40
                ]
              ],
              "at": 3.05,
              "duration": 1.1,
              "ease": "inOutCubic",
              "trail": {
                "color": "$primary",
                "width": 10,
                "length": 0.4,
                "intensity": 1
              }
            }
          },
          {
            "type": "text",
            "text": "Generate",
            "size": 30,
            "weight": 600,
            "letterSpacing": -0.025,
            "y": -30,
            "color": "#FFFFFF",
            "start": 0.5,
            "keyframes": {
              "opacity": [
                {
                  "t": 1.9,
                  "v": 1
                },
                {
                  "t": 2.1,
                  "v": 0
                }
              ]
            },
            "in": {
              "preset": "fade",
              "at": 0.6
            }
          },
          {
            "type": "confetti",
            "y": -30,
            "at": 1.75,
            "count": 70,
            "power": 700,
            "colors": [
              "#4F46E5",
              "#38BDF8",
              "#A5B4FC"
            ]
          },
          {
            "type": "text",
            "text": "Lumen",
            "size": 110,
            "weight": 600,
            "letterSpacing": -0.025,
            "x": -170,
            "y": 40,
            "anchor": "left",
            "align": "left",
            "start": 4.0,
            "in": {
              "preset": "focusIn",
              "duration": 0.8
            }
          },
          {
            "type": "cursor",
            "style": "hand",
            "z": 40,
            "start": 0.6,
            "end": 2.4,
            "path": [
              {
                "t": 0.6,
                "x": 620,
                "y": -460
              },
              {
                "t": 1.45,
                "x": 40,
                "y": -60,
                "ease": "inOutCubic"
              }
            ],
            "clicks": [
              1.65
            ],
            "out": {
              "preset": "fade",
              "duration": 0.25
            }
          }
        ]
      }
    ],
    "score": {
      "style": "warm"
    }
  }
}
