{
  "fps": 30,
  "theme": { "colors": { "bg": "#F7F7FB", "text": "#16161D", "muted": "#8A8A99", "primary": "#4338F5", "secondary": "#5AB4F7" } },
  "post": { "bloom": false, "grain": 0, "vignette": 0 },
  "scenes": [
    {
      "duration": 4,
      "camera": { "dof": { "z": 0, "strength": 0.045, "max": 26 } },
      "layers": [
        { "type": "background", "style": "solid", "color": "$bg" },
        { "type": "text", "text": "Turn books into audio", "y": 300, "size": 72, "weight": 500, "highlight": [{ "text": "books", "color": "$primary" }, { "text": "audio", "color": "$primary" }], "animate": { "preset": "build", "stagger": 0.3 } },
        { "type": "card", "x": -560, "y": 60, "z": -500, "width": 300, "height": 200, "title": "Far card", "shadow": { "blur": 40, "y": -20, "opacity": 0.12, "color": "#4338F5" } },
        { "type": "card", "x": 520, "y": 40, "z": 260, "width": 300, "height": 200, "title": "Near card" },
        { "type": "image", "src": "assets/photo.png", "x": 0, "y": 20, "width": 420, "radius": 18, "in": { "preset": "focusIn", "at": 0.4, "duration": 1.2 } },
        { "type": "shape", "shape": "pill", "x": -300, "y": -300, "width": 260, "height": 64, "fill": { "type": "linear", "from": "$secondary", "to": "$primary", "angle": 90 }, "morphTo": "sparkle",
          "keyframes": { "morph": [{ "t": 1, "v": 0 }, { "t": 2, "v": 1, "ease": "inOutCubic" }], "width": [{ "t": 1, "v": 260 }, { "t": 2, "v": 120, "ease": "inOutCubic" }], "height": [{ "t": 1, "v": 64 }, { "t": 2, "v": 120, "ease": "inOutCubic" }] } },
        { "type": "shape", "shape": "sparkle", "width": 50, "height": 50, "fill": "$primary", "motionPath": { "points": [[-800, -450], [-200, -150], [300, -380], [700, -250]], "at": 0.5, "duration": 2.5, "trail": { "color": "$secondary", "width": 10, "length": 0.4 } } }
      ]
    }
  ]
}
