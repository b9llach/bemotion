{
  "title": "Flowstack Launch",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "bpm": 120,
  "theme": {
    "colors": {
      "bg": "#06060A",
      "surface": "#111118",
      "surface2": "#191922",
      "border": "#2A2A38",
      "text": "#F4F4F8",
      "muted": "#9C9CB0",
      "primary": "#7C5CFF",
      "secondary": "#22D3EE",
      "accent": "#F472B6"
    },
    "fonts": { "display": "Sora", "body": "Inter", "mono": "JetBrains Mono" }
  },
  "post": { "bloom": { "strength": 0.8, "threshold": 0.95 }, "grain": 0.03, "vignette": 0.3, "chromatic": 1.2 },
  "motionBlur": { "samples": 10, "shutter": 0.6 },
  "scenes": [
    {
      "id": "hook",
      "duration": "5b",
      "camera": {
        "moves": [
          { "preset": "punch", "at": 0.15, "amount": 5 },
          { "preset": "punch", "at": 0.95, "amount": 5 },
          { "preset": "punch", "at": 1.75, "amount": 6 },
          { "preset": "drift", "amount": 10 }
        ]
      },
      "layers": [
        { "type": "background", "style": "radial", "colors": ["#120E24", "#06060A"], "center": [0, 0], "intensity": 1.1 },
        { "type": "particles", "count": 600, "motion": "warp", "colors": ["#FFFFFF", "#7C5CFF", "#22D3EE"], "size": [1.5, 4], "speed": 1.2 },
        { "type": "group", "id": "chaos", "out": { "preset": "pushIn", "duration": 0.45 }, "children": [
          { "type": "group", "x": -720, "y": 300, "rotate": -8, "in": { "preset": "popIn", "at": 0.05 }, "loop": { "preset": "wobble", "amount": 5, "period": 0.9 }, "children": [
            { "type": "shape", "width": 110, "height": 110, "radius": 28, "fill": "$surface2", "stroke": "$border", "shadow": { "blur": 30, "y": -12, "opacity": 0.5 } },
            { "type": "icon", "name": "mail", "size": 54, "color": "#F87171" }
          ]},
          { "type": "group", "x": 700, "y": 320, "rotate": 10, "in": { "preset": "popIn", "at": 0.15 }, "loop": { "preset": "wobble", "amount": 6, "period": 0.8, "phase": 1 }, "children": [
            { "type": "shape", "width": 110, "height": 110, "radius": 28, "fill": "$surface2", "stroke": "$border", "shadow": { "blur": 30, "y": -12, "opacity": 0.5 } },
            { "type": "icon", "name": "message", "size": 54, "color": "#FBBF24" }
          ]},
          { "type": "group", "x": -640, "y": -300, "rotate": 12, "in": { "preset": "popIn", "at": 0.3 }, "loop": { "preset": "wobble", "amount": 5, "period": 1.1, "phase": 2 }, "children": [
            { "type": "shape", "width": 110, "height": 110, "radius": 28, "fill": "$surface2", "stroke": "$border", "shadow": { "blur": 30, "y": -12, "opacity": 0.5 } },
            { "type": "icon", "name": "bell", "size": 54, "color": "#22D3EE" }
          ]},
          { "type": "group", "x": 660, "y": -290, "rotate": -12, "in": { "preset": "popIn", "at": 0.45 }, "loop": { "preset": "wobble", "amount": 6, "period": 0.7, "phase": 3 }, "children": [
            { "type": "shape", "width": 110, "height": 110, "radius": 28, "fill": "$surface2", "stroke": "$border", "shadow": { "blur": 30, "y": -12, "opacity": 0.5 } },
            { "type": "icon", "name": "calendar", "size": 54, "color": "#F472B6" }
          ]},
          { "type": "group", "x": -260, "y": 400, "rotate": 6, "scale": 0.8, "in": { "preset": "popIn", "at": 0.6 }, "loop": { "preset": "wobble", "amount": 7, "period": 0.6 }, "children": [
            { "type": "shape", "width": 110, "height": 110, "radius": 28, "fill": "$surface2", "stroke": "$border" },
            { "type": "icon", "name": "file", "size": 54, "color": "$muted" }
          ]},
          { "type": "group", "x": 280, "y": -410, "rotate": -6, "scale": 0.8, "in": { "preset": "popIn", "at": 0.75 }, "loop": { "preset": "wobble", "amount": 7, "period": 0.65, "phase": 2 }, "children": [
            { "type": "shape", "width": 110, "height": 110, "radius": 28, "fill": "$surface2", "stroke": "$border" },
            { "type": "icon", "name": "inbox", "size": 54, "color": "$muted" }
          ]}
        ]},
        { "type": "text", "text": "Too many tabs.", "size": 150, "weight": 800, "end": 0.95, "animate": { "preset": "slam", "by": "word", "at": 0.15, "stagger": 0.1 } },
        { "type": "text", "text": "Too many tools.", "size": 150, "weight": 800, "start": 0.95, "end": 1.75, "animate": { "preset": "slam", "by": "word", "at": 0.95, "stagger": 0.1 } },
        { "type": "text", "text": "Not enough time.", "size": 150, "weight": 800, "start": 1.75, "highlight": [{ "text": "time.", "color": "$accent" }], "animate": { "preset": "slam", "by": "word", "at": 1.75, "stagger": 0.1 } }
      ]
    },
    {
      "id": "reveal",
      "duration": 3.4,
      "post": { "bloom": { "strength": 0.6, "threshold": 1.25 } },
      "transition": { "type": "glitch", "duration": 0.35 },
      "camera": { "moves": [{ "preset": "pushIn", "amount": 260, "duration": 3.4, "ease": "outCubic" }, { "preset": "drift", "amount": 8 }] },
      "layers": [
        { "type": "background", "style": "rays", "colors": ["#07070C", "#3A2A8C"], "center": [0, 120], "intensity": 0.7 },
        { "type": "mesh", "geometry": "blob", "material": "iridescent", "color": "#2C2080", "roughness": 0.45, "size": 760, "z": -1300, "y": 40, "in": { "preset": "zoomIn", "duration": 1.2 }, "loop": { "preset": "spin", "axis": "y", "speed": 25 } },
        { "type": "particles", "count": 200, "motion": "drift", "colors": ["#FFFFFF", "#22D3EE"], "size": [1.5, 3.5] },
        { "type": "group", "y": 150, "in": { "preset": "popIn", "at": 0.15 }, "children": [
          { "type": "shape", "width": 150, "height": 150, "radius": 40, "fill": { "type": "linear", "from": "$primary", "to": "$secondary", "angle": 135 }, "glow": { "size": 40, "intensity": 0.6 }, "intensity": 1.15 },
          { "type": "icon", "name": "workflow", "size": 82, "color": "#FFFFFF", "strokeWidth": 2.2 }
        ]},
        { "type": "text", "text": "Flowstack", "y": -40, "size": 170, "weight": 700, "letterSpacing": -0.035, "animate": { "preset": "tracking", "at": 0.35, "duration": 1.4, "amount": 0.9 } },
        { "type": "text", "text": "Automate the busywork.", "y": -165, "size": 50, "weight": 500, "font": "body", "color": "$muted", "letterSpacing": -0.01, "animate": { "preset": "lift", "by": "word", "at": 1.0, "stagger": 0.07 } }
      ]
    },
    {
      "id": "product",
      "duration": 5.4,
      "transition": { "type": "zoom", "duration": 0.5 },
      "camera": {
        "targetY": 0,
        "moves": [
          { "preset": "pushIn", "amount": 220, "duration": 5.4, "ease": "inOutSine" },
          { "preset": "orbit", "angle": -9, "duration": 5.4, "ease": "inOutSine" },
          { "preset": "punch", "at": 2.62, "amount": 3 }
        ]
      },
      "layers": [
        { "type": "background", "style": "radial", "colors": ["#15112B", "#06060A"], "center": [0, 250] },
        { "type": "grid", "color": "$primary/22", "speed": 70 },
        { "type": "browser", "url": "app.flowstack.io/workflows", "width": 1440, "height": 840, "y": 10, "rotateX": 6, "in": { "preset": "tiltIn", "duration": 1.1 }, "children": [
          { "type": "shape", "x": -608, "width": 222, "height": 790, "fill": "#0F0F15" },
          { "type": "shape", "x": -497, "width": 1, "height": 790, "fill": "$border" },
          { "type": "group", "x": -690, "y": 340, "children": [
            { "type": "shape", "x": 14, "width": 30, "height": 30, "radius": 9, "fill": { "type": "linear", "from": "$primary", "to": "$secondary", "angle": 135 } },
            { "type": "text", "text": "Flowstack", "x": 42, "size": 21, "weight": 700, "align": "left", "anchor": "left" }
          ]},
          { "type": "shape", "x": -608, "y": 254, "width": 196, "height": 42, "radius": 10, "fill": "$primary/18" },
          { "type": "icon", "name": "workflow", "x": -686, "y": 254, "size": 20, "color": "$primary" },
          { "type": "text", "text": "Workflows", "x": -664, "y": 254, "size": 18, "weight": 600, "font": "body", "align": "left", "anchor": "left", "color": "$text" },
          { "type": "icon", "name": "activity", "x": -686, "y": 200, "size": 20, "color": "$muted" },
          { "type": "text", "text": "Runs", "x": -664, "y": 200, "size": 18, "weight": 500, "font": "body", "align": "left", "anchor": "left", "color": "$muted" },
          { "type": "icon", "name": "link", "x": -686, "y": 146, "size": 20, "color": "$muted" },
          { "type": "text", "text": "Integrations", "x": -664, "y": 146, "size": 18, "weight": 500, "font": "body", "align": "left", "anchor": "left", "color": "$muted" },
          { "type": "icon", "name": "users", "x": -686, "y": 92, "size": 20, "color": "$muted" },
          { "type": "text", "text": "Team", "x": -664, "y": 92, "size": 18, "weight": 500, "font": "body", "align": "left", "anchor": "left", "color": "$muted" },

          { "type": "text", "text": "Workflows", "x": -450, "y": 330, "size": 34, "weight": 700, "align": "left", "anchor": "left" },
          { "type": "text", "text": "12 active, 3 scheduled", "x": -450, "y": 290, "size": 17, "font": "body", "weight": 400, "color": "$muted", "align": "left", "anchor": "left" },
          { "type": "button", "id": "run", "label": "Run workflow", "icon": "play", "x": 560, "y": 316, "size": 18, "press": 2.62 },

          { "type": "group", "x": -293, "y": 170, "in": { "preset": "slideUp", "at": 0.5, "distance": 40 }, "children": [
            { "type": "shape", "width": 300, "height": 150, "radius": 18, "fill": "$surface", "stroke": "$border" },
            { "type": "text", "text": "Tasks automated", "x": -125, "y": 34, "size": 17, "font": "body", "weight": 500, "color": "$muted", "align": "left", "anchor": "left" },
            { "type": "counter", "from": 1200000, "to": 2481920, "x": -125, "y": -18, "size": 44, "weight": 700, "anchor": "left", "at": 0.6, "duration": 2.2 }
          ]},
          { "type": "group", "x": 27, "y": 170, "in": { "preset": "slideUp", "at": 0.6, "distance": 40 }, "children": [
            { "type": "shape", "width": 300, "height": 150, "radius": 18, "fill": "$surface", "stroke": "$border" },
            { "type": "text", "text": "Hours saved", "x": -125, "y": 34, "size": 17, "font": "body", "weight": 500, "color": "$muted", "align": "left", "anchor": "left" },
            { "type": "counter", "from": 3000, "to": 18240, "x": -125, "y": -18, "size": 44, "weight": 700, "anchor": "left", "at": 0.7, "duration": 2.2 }
          ]},
          { "type": "group", "x": 347, "y": 170, "in": { "preset": "slideUp", "at": 0.7, "distance": 40 }, "children": [
            { "type": "shape", "width": 300, "height": 150, "radius": 18, "fill": "$surface", "stroke": "$border" },
            { "type": "text", "text": "Success rate", "x": -125, "y": 34, "size": 17, "font": "body", "weight": 500, "color": "$muted", "align": "left", "anchor": "left" },
            { "type": "counter", "from": 90, "to": 99.9, "decimals": 1, "suffix": "%", "x": -125, "y": -18, "size": 44, "weight": 700, "anchor": "left", "color": "$success", "at": 0.8, "duration": 2.2 },
            { "type": "badge", "label": "+2.1%", "icon": "trending-up", "x": 72, "y": -18, "size": 14, "color": "#34D399" }
          ]},

          { "type": "group", "x": -133, "y": -170, "in": { "preset": "slideUp", "at": 0.8, "distance": 40 }, "children": [
            { "type": "shape", "width": 620, "height": 420, "radius": 18, "fill": "$surface", "stroke": "$border" },
            { "type": "text", "text": "Runs this week", "x": -280, "y": 170, "size": 19, "font": "body", "weight": 600, "align": "left", "anchor": "left" },
            { "type": "text", "text": "Mon - Sun", "x": 280, "y": 170, "size": 15, "font": "body", "weight": 400, "color": "$muted", "align": "right", "anchor": "right" },
            { "type": "chart", "kind": "area", "data": [18, 24, 21, 33, 29, 42, 38, 51, 47, 63], "width": 560, "height": 280, "y": -30, "at": 1.0, "duration": 1.8 }
          ]},
          { "type": "group", "x": 347, "y": -170, "in": { "preset": "slideUp", "at": 0.9, "distance": 40 }, "children": [
            { "type": "shape", "width": 300, "height": 420, "radius": 18, "fill": "$surface", "stroke": "$border" },
            { "type": "text", "text": "Live runs", "x": -125, "y": 170, "size": 19, "font": "body", "weight": 600, "align": "left", "anchor": "left" },
            { "type": "group", "y": 95, "in": { "preset": "slideLeft", "at": 1.2, "distance": 60 }, "children": [
              { "type": "shape", "width": 260, "height": 64, "radius": 12, "fill": "$surface2" },
              { "type": "icon", "name": "mail", "x": -100, "size": 22, "color": "$secondary" },
              { "type": "text", "text": "Lead to CRM", "x": -76, "size": 16, "font": "body", "weight": 500, "align": "left", "anchor": "left" },
              { "type": "shape", "shape": "circle", "x": 104, "width": 10, "fill": "$success", "glow": { "size": 8, "intensity": 0.8 } }
            ]},
            { "type": "group", "y": 20, "in": { "preset": "slideLeft", "at": 1.35, "distance": 60 }, "children": [
              { "type": "shape", "width": 260, "height": 64, "radius": 12, "fill": "$surface2" },
              { "type": "icon", "name": "credit-card", "x": -100, "size": 22, "color": "$primary" },
              { "type": "text", "text": "Invoice sync", "x": -76, "size": 16, "font": "body", "weight": 500, "align": "left", "anchor": "left" },
              { "type": "shape", "shape": "circle", "x": 104, "width": 10, "fill": "$success", "glow": { "size": 8, "intensity": 0.8 } }
            ]},
            { "type": "group", "y": -55, "in": { "preset": "slideLeft", "at": 1.5, "distance": 60 }, "children": [
              { "type": "shape", "width": 260, "height": 64, "radius": 12, "fill": "$surface2" },
              { "type": "icon", "name": "message", "x": -100, "size": 22, "color": "$accent" },
              { "type": "text", "text": "Slack digest", "x": -76, "size": 16, "font": "body", "weight": 500, "align": "left", "anchor": "left" },
              { "type": "shape", "shape": "circle", "x": 104, "width": 10, "fill": "$warning", "loop": { "preset": "breathe", "amount": 0.7, "period": 0.8 } }
            ]},
            { "type": "group", "y": -130, "in": { "preset": "slideLeft", "at": 1.65, "distance": 60 }, "children": [
              { "type": "shape", "width": 260, "height": 64, "radius": 12, "fill": "$surface2" },
              { "type": "icon", "name": "database", "x": -100, "size": 22, "color": "$secondary" },
              { "type": "text", "text": "Nightly backup", "x": -76, "size": 16, "font": "body", "weight": 500, "align": "left", "anchor": "left" },
              { "type": "shape", "shape": "circle", "x": 104, "width": 10, "fill": "$success", "glow": { "size": 8, "intensity": 0.8 } }
            ]}
          ]}
        ]},
        { "type": "cursor", "z": 60, "path": [
          { "t": 1.3, "x": 120, "y": -320 },
          { "t": 2.5, "x": 570, "y": 318, "ease": "inOutQuart" },
          { "t": 3.6, "x": 380, "y": 120, "ease": "inOutCubic" }
        ], "clicks": [2.6], "in": { "preset": "fade", "at": 1.2, "duration": 0.3 } },
        { "type": "toast", "title": "Workflow complete", "body": "142 records synced in 1.2s", "icon": "check", "x": 640, "y": -360, "z": 120, "start": 2.9, "in": { "preset": "slideUp", "distance": 80, "ease": "springSoft", "duration": 0.7 }, "out": { "preset": "fade", "duration": 0.3 } },
        { "type": "flash", "at": 2.62, "duration": 0.25, "intensity": 0.12, "color": "$primary" }
      ]
    },
    {
      "id": "features",
      "duration": 4.2,
      "transition": { "type": "whip", "duration": 0.45, "direction": "left" },
      "camera": { "moves": [{ "preset": "pushIn", "amount": 160, "duration": 4.2 }, { "preset": "drift", "amount": 12 }] },
      "layers": [
        { "type": "background", "style": "aurora", "colors": ["#06060A", "#2B1A6B", "#0B3B4F", "#3B1236"], "intensity": 0.75 },
        { "type": "text", "text": "Built for teams that move fast.", "y": 330, "size": 70, "weight": 700, "highlight": [{ "text": "move fast.", "color": "$secondary" }], "animate": { "preset": "rise", "by": "word", "at": 0.15, "stagger": 0.06 } },
        { "type": "card", "x": -500, "y": -90, "width": 420, "height": 440, "icon": "link", "accent": "$secondary", "title": "Connect 200+ apps", "subtitle": "Slack, Notion, Stripe, GitHub and more. Two clicks, zero code.", "in": { "preset": "swingIn", "at": 0.45, "angle": 70 }, "loop": { "preset": "float", "amount": 10, "period": 3.2 }, "children": [
          { "type": "group", "y": -120, "children": [
            { "type": "avatar", "initials": "SL", "x": -110, "size": 56, "fill": "#4A154B", "in": { "preset": "popIn", "at": 1.1 } },
            { "type": "avatar", "initials": "NO", "x": -40, "size": 56, "fill": "#2F2F2F", "in": { "preset": "popIn", "at": 1.2 } },
            { "type": "avatar", "initials": "ST", "x": 30, "size": 56, "fill": "#635BFF", "in": { "preset": "popIn", "at": 1.3 } },
            { "type": "avatar", "initials": "GH", "x": 100, "size": 56, "fill": "#24292F", "in": { "preset": "popIn", "at": 1.4 } }
          ]}
        ]},
        { "type": "card", "x": 0, "y": -90, "width": 420, "height": 440, "icon": "sparkles", "accent": "$primary", "title": "AI writes the steps", "subtitle": "Describe the outcome in plain English. Flowstack builds the workflow.", "in": { "preset": "swingIn", "at": 0.6, "angle": 70 }, "loop": { "preset": "float", "amount": 10, "period": 3.2, "phase": 1.2 }, "children": [
          { "type": "shape", "y": -120, "width": 356, "height": 60, "radius": 12, "fill": "$bg", "stroke": "$border" },
          { "type": "text", "text": "When a deal closes, invoice it", "x": -160, "y": -120, "size": 17, "font": "mono", "weight": 400, "color": "$text", "align": "left", "anchor": "left", "letterSpacing": 0, "animate": { "preset": "typewriter", "at": 1.2, "stagger": 0.035 } }
        ]},
        { "type": "card", "x": 500, "y": -90, "width": 420, "height": 440, "icon": "zap", "accent": "$accent", "title": "Runs in milliseconds", "subtitle": "Event-driven engine with retries, logs and alerts built in.", "in": { "preset": "swingIn", "at": 0.75, "angle": 70 }, "loop": { "preset": "float", "amount": 10, "period": 3.2, "phase": 2.4 }, "children": [
          { "type": "progress", "y": -120, "width": 340, "height": 10, "value": 1, "at": 1.3, "duration": 0.9, "color": { "type": "linear", "from": "$accent", "to": "$primary", "angle": 90 } },
          { "type": "counter", "from": 0, "to": 38, "suffix": " ms", "y": -160, "x": 170, "size": 22, "weight": 600, "font": "mono", "anchor": "right", "color": "$muted", "at": 1.3, "duration": 0.9 }
        ]}
      ]
    },
    {
      "id": "stats",
      "duration": 3.6,
      "transition": { "type": "push", "duration": 0.45, "direction": "up" },
      "camera": { "moves": [
        { "preset": "punch", "at": 0.25, "amount": 4 },
        { "preset": "punch", "at": 0.55, "amount": 4 },
        { "preset": "punch", "at": 0.85, "amount": 4 },
        { "preset": "pushIn", "amount": 120, "duration": 3.6 }
      ]},
      "layers": [
        { "type": "background", "style": "dots", "colors": ["#07070B", "#2E2E44"], "center": [0, 80] },
        { "type": "glow", "x": 0, "y": 80, "size": 1500, "color": "$primary", "intensity": 0.22 },
        { "type": "counter", "from": 1, "to": 10, "suffix": "x", "x": -590, "y": 130, "size": 128, "weight": 800, "color": "$text", "at": 0.25, "duration": 1.4, "in": { "preset": "slam", "at": 0.25 } },
        { "type": "text", "text": "faster onboarding", "x": -590, "y": -10, "size": 30, "weight": 500, "font": "body", "color": "$muted", "in": { "preset": "slideUp", "at": 0.4, "distance": 30 } },
        { "type": "counter", "from": 0.2, "to": 2.4, "decimals": 1, "suffix": "M", "x": 0, "y": 130, "size": 128, "weight": 800, "color": "$primary", "intensity": 1.3, "at": 0.55, "duration": 1.4, "in": { "preset": "slam", "at": 0.55 } },
        { "type": "text", "text": "tasks run every week", "x": 0, "y": -10, "size": 30, "weight": 500, "font": "body", "color": "$muted", "in": { "preset": "slideUp", "at": 0.7, "distance": 30 } },
        { "type": "counter", "from": 90, "to": 99.99, "decimals": 2, "suffix": "%", "x": 590, "y": 130, "size": 128, "weight": 800, "color": "$text", "at": 0.85, "duration": 1.4, "in": { "preset": "slam", "at": 0.85 } },
        { "type": "text", "text": "uptime SLA", "x": 590, "y": -10, "size": 30, "weight": 500, "font": "body", "color": "$muted", "in": { "preset": "slideUp", "at": 1.0, "distance": 30 } },
        { "type": "text", "text": "TRUSTED BY 4,000+ TEAMS", "y": -250, "size": 24, "weight": 600, "font": "body", "letterSpacing": 0.16, "color": "$muted", "in": { "preset": "fade", "at": 1.1 } },
